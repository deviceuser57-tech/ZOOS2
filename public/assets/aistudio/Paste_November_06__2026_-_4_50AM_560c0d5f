-- سياسة: العملاء يقرؤون ويعدلون ملفاتهم الخاصة فقط
CREATE POLICY profiles_user_policy ON public.profiles 
    FOR ALL USING (auth.uid() = id);

-- سياسة: العملاء يقرؤون طلباتهم الخاصة فقط، والإدارة تقرأ الكل
CREATE POLICY orders_customer_policy ON public.orders 
    FOR SELECT USING (
        auth.uid() = customer_id OR 

-- 3. مواقع المخزون والأرصدة الحرة (Multi-Location Inventory Balances)
CREATE TABLE public.inventory_locations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name TEXT NOT NULL,
    location_type TEXT NOT NULL CHECK (location_type IN ('x_mall_store', 'central_warehouse', 'supplier_dropship')),

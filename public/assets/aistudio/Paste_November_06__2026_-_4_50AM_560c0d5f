      console.error('CJ Order Submission Error:', error?.response?.data || error.message);
      return { success: false, error: error.message };
    }
  }
}
4.2. محول الربط العام مع AliExpress / WooCommerce Dropshipping Nodes (GenericDropshipAdapter.ts)export class GenericDropshipAdapter {
  public static async dispatchOrderToWooSupplier(
    endpointUrl: string,
    consumerKey: string,
    consumerSecret: string,
    orderData: any
  ) {
    const authHeader = 'Basic ' + Buffer.from(`${consumerKey}:${consumerSecret}`).toString('base64');
    
    const response = await fetch(`${endpointUrl}/wp-json/wc/v3/orders`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': authHeader
      },
      body: JSON.stringify(orderData)
    });

    if (!response.ok) {
      const errText = await response.text();
      throw new Error(`External WooCommerce Dropship Failed: ${errText}`);
    }

    return await response.json();
  }
}
5. الحلول البرمجية الكاملة والتنفيذية (Full Code Implementation)5.1. كود قفل منع السباق الذري وتحديث الأرصدة (Atomic Race Condition Prevention)يتم تنفيذه مباشرة داخل خادم Node.js / Express المربوط بقاعدة بيانات PostgreSQL للتحقق الذري من الرصيد وقفل الصف أثناء حجز المشتريات:import { Pool } from 'pg';

const pool = new Pool({
  connectionString: process.env.DATABASE_URL
});

export interface ReserveStockInput {
  variantId: string;
  locationId: string;
  requestedQty: number;
  orderId: string;
}

export async function reserveStockAtomic(input: ReserveStockInput): Promise<{ success: boolean; message: string }> {
  const client = await pool.connect();

  try {
    // 1. بدء المعاملة المباشرة
    await client.query('BEGIN');

    // 2. تطبيق القفل التشاؤمي SELECT FOR UPDATE لمنع البيع المزدوج في نفس الميلي ثانية
    const selectQuery = `
      SELECT quantity_on_hand, quantity_reserved 
      FROM public.owned_stock_balances 
      WHERE variant_id = $1 AND location_id = $2 
      FOR UPDATE;
    `;
    const res = await client.query(selectQuery, [input.variantId, input.locationId]);

    if (res.rows.length === 0) {
      await client.query('ROLLBACK');
      return { success: false, message: 'Stock record not found' };
    }

    const { quantity_on_hand, quantity_reserved } = res.rows[0];
    const availableStock = quantity_on_hand - quantity_reserved;

    // 3. التحقق الرياضي من التوفر
    if (availableStock < input.requestedQty) {
      await client.query('ROLLBACK');
      return { success: false, message: 'Stockout conflict: Insufficient inventory available' };
    }

    // 4. تحديث الرصيد المحجوز
    const updateQuery = `
      UPDATE public.owned_stock_balances 
      SET quantity_reserved = quantity_reserved + $1,
          updated_at = NOW() 
      WHERE variant_id = $2 AND location_id = $3;
    `;
    await client.query(updateQuery, [input.requestedQty, input.variantId, input.locationId]);

    // 5. كتابة الحدث في طابور الأحداث Transactional Outbox بنفس المعاملة
    const outboxQuery = `
      INSERT INTO public.transactional_outbox (event_type, aggregate_type, aggregate_id, payload)
      VALUES ($1, $2, $3, $4);
    `;
    const payload = JSON.stringify({
      orderId: input.orderId,
      variantId: input.variantId,
      reservedQty: input.requestedQty,
      locationId: input.locationId
    });
    await client.query(outboxQuery, ['STOCK_RESERVED', 'ORDER', input.orderId, payload]);

    // 6. اعتماد المعاملة نهائياً
    await client.query('COMMIT');
    return { success: true, message: 'Stock successfully reserved atomically' };

  } catch (error: any) {
    await client.query('ROLLBACK');
    console.error('Atomic reservation error:', error.message);
    return { success: false, message: `Database transaction error: ${error.message}` };
  } finally {
    client.release();
  }
}
5.2. كود التحقق من توقيع HMAC المشفر لبوابة Paymob (PaymobHMACValidator.ts)import crypto from 'crypto';

export interface PaymobCallbackPayload {
  amount_cents: string;
  created_at: string;
  currency: string;
  error_occured: string;
  has_parent_transaction: string;
  id: string;
  integration_id: string;
  is_3d_secure: string;
  is_auth: string;
  is_capture: string;
  is_standalone_payment: string;
  is_voided: string;
  order: string;
  owner: string;
  pending: string;
  source_data_pan: string;
  source_data_sub_type: string;
  source_data_type: string;
  success: string;
  hmac: string;
}

export class PaymobHMACValidator {
  public static validateHMAC(payload: PaymobCallbackPayload, hmacSecret: string): boolean {
    // الترتيب الصارم المعتمد من وثائق Paymob الرسمية لتركيب السلسلة
    const concatenatedString = [
      payload.amount_cents,
      payload.created_at,
      payload.currency,
      payload.error_occured,
      payload.has_parent_transaction,
      payload.id,
      payload.integration_id,
      payload.is_3d_secure,
      payload.is_auth,
      payload.is_capture,
      payload.is_standalone_payment,
      payload.is_voided,
      payload.order,
      payload.owner,
      payload.pending,
      payload.source_data_pan,
      payload.source_data_sub_type,
      payload.source_data_type,
      payload.success
    ].join('');

    const calculatedHmac = crypto
      .createHmac('sha512', hmacSecret)
      .update(concatenatedString)
      .digest('hex');

    return calculatedHmac.toLowerCase() === payload.hmac.toLowerCase();
  }
}
5.3. كود أداة فحص التوافق الذكي للأجهزة (CompatibilityEngine.ts)export interface ProductCompatibilitySpec {
  id: string;
  name_ar: string;
  name_en: string;
  brand: string;
  category: string;
  compatibility_tags: string[];
}

export class CompatibilityEngine {
  public static filterCompatibleProducts(
    deviceModel: string, // e.g. "iPhone 16 Pro Max"
    requiredConnector?: string, // e.g. "Type-C"
    products: ProductCompatibilitySpec[] = []
  ): ProductCompatibilitySpec[] {
    const normalizedDevice = deviceModel.trim().toLowerCase();
    
    return products.filter(product => {
      const matchesDevice = product.compatibility_tags.some(tag => 
        tag.toLowerCase().includes(normalizedDevice) || normalizedDevice.includes(tag.toLowerCase())
      );

      if (requiredConnector) {
        const matchesConnector = product.compatibility_tags.some(tag => 
          tag.toLowerCase() === requiredConnector.toLowerCase()
        );
        return matchesDevice && matchesConnector;
      }

      return matchesDevice;
    });
  }
}
